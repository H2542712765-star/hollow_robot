<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 基础通用材质 透明度设置为0.5-->
    <material name="white">
        <color rgba="1 1 1 0.5"/>
    </material>

    <material name="dark_blue">
        <color rgba="0 0 0.52 0.5"/>
    </material>

    <material name="black">
        <color rgba="0 0 0 0.8"/>
    </material>

    <!-- 彩虹七色材质 透明度0.5 -->
    <material name="red">
        <color rgba="1 0 0 0.5"/>
    </material>
    <material name="orange">
        <color rgba="1 0.5 0 0.5"/>
    </material>
    <material name="yellow">
        <color rgba="1 1 0 0.5"/>
    </material>
    <material name="green">
        <color rgba="0 1 0 0.5"/>
    </material>
    <material name="cyan">
        <color rgba="0 1 1 0.5"/>
    </material>
    <material name="blue">
        <color rgba="0 0 1 0.5"/>
    </material>
    <material name="purple">
        <color rgba="0.6 0 1 0.5"/>
    </material>
</robot>