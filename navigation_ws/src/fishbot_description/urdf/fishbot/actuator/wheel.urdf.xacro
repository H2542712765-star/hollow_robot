<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="wheel_xacro" params="wheel_name xyz">
        <link name="${wheel_name}_link">
            <visual>
                <origin xyz="0 0 0" rpy="1.5708 0 0"/>
                <geometry>
                    <cylinder radius="0.072" length="0.06"/>
                </geometry>
                <material name="black"/>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="1.5708 0 0"/>
                    <geometry>
                        <cylinder radius="0.072" length="0.06"/>
                    </geometry>                
            </collision>

            <xacro:cylinder_inertia m="0.12" r="0.072" h="0.06" />            
        </link>
        <joint name="${wheel_name}_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${wheel_name}_link"/>
            <origin xyz="${xyz}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>


        <gazebo reference="${wheel_name}_link">
            <!-- 沿轮子滚动方向的摩擦系数（纵向摩擦） -->
            <mu1 value="1.0"/>
            <!-- 垂直于轮子滚动方向的摩擦系数（横向摩擦） -->
            <mu2 value="1.0"/>
            <!-- 法向刚度 -->
            <k1 value="100000.0"/>
            <!-- 切向刚度 -->
            <k2 value="1.0"/>
        </gazebo>
    </xacro:macro> 
</robot>