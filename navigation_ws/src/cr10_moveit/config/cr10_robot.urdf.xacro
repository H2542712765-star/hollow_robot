<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fishbot_cr10">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import cr10_robot urdf file -->
    <xacro:include filename="$(find mobile_manipulator_description)/urdf/mobile_manipulator.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="cr10_robot.ros2_control.xacro" />


    <xacro:cr10_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
